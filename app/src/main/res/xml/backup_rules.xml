<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Defense in depth for Android 11 and lower. android:allowBackup is already false, but keep
         explicit exclusions so PhotoBook's local-only state is never eligible for Auto Backup. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
